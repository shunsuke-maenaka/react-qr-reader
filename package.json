{
  "name": "@memenashi/react-qr-reader",
  "version": "0.2.7",
  "description": "A React Component for reading QR codes from the webcam",
  "scripts": {
    "build": "rollup --config rollup.config.js",
    "prettier": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "prettier:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "eslint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "eslint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint": "npm-run-all prettier eslint",
    "lint:fix": "run-s prettier:fix eslint:fix",
    "storybook": "storybook dev -p 6006 --https --ssl-cert ./certs/storybook.cert --ssl-key ./certs/storybook.key",
    "storybook:build": "storybook build -o ./storybook-static",
    "predeploy": "storybook build -o ./storybook-static",
    "deploy": "gh-pages -d storybook-static",
    "prebuild": "tsc"
  },
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memenashi/react-qr-reader.git"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "qr",
    "qrcode",
    "qrreader"
  ],
  "author": "memenashi",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-mdx-gfm": "8.6.14",
    "@storybook/cli": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-webpack5": "^10.6.0",
    "@storybook/storybook-deployer": "^2.8.16",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "babel-loader": "^10.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^4.63.3",
    "rollup-plugin-cleaner": "^1.0.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-web-worker-loader": "^1.7.0",
    "source-map-explorer": "^2.5.3",
    "storybook": "^10.6.0",
    "strip-ansi": "^7.2.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3"
  }
}
