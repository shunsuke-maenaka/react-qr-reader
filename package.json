{
  "name": "@memenashi/react-qr-reader",
  "version": "0.2.7",
  "description": "A React Component for reading QR codes from the webcam",
  "scripts": {
    "build": "rollup --config rollup.config.js",
    "prettier": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "prettier:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "eslint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "eslint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint": "npm-run-all prettier eslint",
    "lint:fix": "run-s prettier:fix eslint:fix",
    "storybook": "storybook dev -p 6006 --https --ssl-cert ./certs/storybook.cert --ssl-key ./certs/storybook.key",
    "storybook:build": "storybook build -o ./storybook-static",
    "predeploy": "storybook build -o ./storybook-static",
    "deploy": "gh-pages -d storybook-static",
    "prebuild": "tsc"
  },
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memenashi/react-qr-reader.git"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "qr",
    "qrcode",
    "qrreader"
  ],
  "author": "memenashi",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-typescript": "^11.1.6",
    "@storybook/addon-actions": "^7.6.24",
    "@storybook/addon-essentials": "^7.6.24",
    "@storybook/addon-mdx-gfm": "^7.6.24",
    "@storybook/cli": "^7.6.24",
    "@storybook/react": "^7.6.24",
    "@storybook/react-webpack5": "^7.6.24",
    "@storybook/storybook-deployer": "^2.8.16",
    "@types/react": "^18.3.31",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "babel-loader": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-storybook": "^0.6.15",
    "gh-pages": "^6.3.0",
    "npm-run-all2": "^5.0.0",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^3.30.0",
    "rollup-plugin-cleaner": "^1.0.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript2": "^0.35.0",
    "rollup-plugin-web-worker-loader": "^1.7.0",
    "source-map-explorer": "^2.5.3",
    "storybook": "^7.6.24",
    "strip-ansi": "^6.0.1",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3"
  }
}
